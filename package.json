{
  "name": "velocity",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @velocity/web dev",
    "build": "pnpm -r run build",
    "lint": "pnpm run lint:root && pnpm -r run lint",
    "lint:root": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "corpus": "node scripts/build-corpus.mjs && node scripts/build-chat-prompt.mjs",
    "index": "pnpm --filter @velocity/corpus-index index",
    "index:check": "pnpm --filter @velocity/corpus-index index:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1",
    "zod": "^3.25.76"
  }
}
